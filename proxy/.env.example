# Copy to .env and fill in real values. Never commit .env.
# Run the server with: node --env-file=.env server.js

SERPAPI_KEY=
GOOGLE_MAPS_API_KEY=

# Required: Gemini API key (Google AI Studio / Generative Language API).
GEMINI_API_KEY=

# Optional overrides — defaults live in geminiClient.js.
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=20000

# Required for POST /recommendations: firebase-admin verifies the caller's ID
# token and reads Firestore. Path to a service-account JSON (keep it outside
# the repo); on Cloud Run the runtime service account is used instead.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=syncinary-48881

# Number of reverse-proxy hops to trust for X-Forwarded-For (Express
# `trust proxy`). Leave at 0 locally; set to 1 on Cloud Run so the
# /recommendations per-IP rate limit sees real client addresses.
TRUST_PROXY_HOPS=0
